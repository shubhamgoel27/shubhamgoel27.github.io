---
// Casual, personal easter-egg hunt. The eggs (COYG, Konami, pocket aces, padel,
// and the dev console) each reveal a small personal note instead of just confetti.
// Nothing shows up until you stumble on your first one. No forced HUD.
---
<div id="secret-toast" class="secret-toast" role="status" aria-live="polite"></div>

<button id="secret-badge" class="secret-badge" type="button" aria-haspopup="dialog" aria-expanded="false" hidden>
  <span class="mark" aria-hidden="true">✦</span>
  <span class="count" id="secret-count"></span>
</button>

<div id="secret-panel" class="secret-panel" role="dialog" aria-label="Little things I've hidden around the site" hidden></div>

<style>
  .secret-toast {
    position: fixed;
    left: 50%;
    bottom: 2rem;
    transform: translate(-50%, 1rem);
    background: var(--ink);
    color: var(--paper);
    padding: 0.6rem 1rem;
    border-radius: var(--radius-pill);
    font-size: 0.9rem;
    font-weight: 540;
    box-shadow: var(--shadow-lg);
    opacity: 0;
    pointer-events: none;
    z-index: 200;
    transition: opacity 0.25s ease, transform 0.35s cubic-bezier(0.2, 1.3, 0.4, 1);
    white-space: nowrap;
  }
  .secret-toast.show { opacity: 1; transform: translate(-50%, 0); }

  /* the quiet marker, only appears after your first find */
  .secret-badge {
    position: fixed;
    left: 1.4rem;
    bottom: 1.3rem;
    z-index: 190;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.34rem 0.7rem 0.34rem 0.6rem;
    background: var(--paper-raised);
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    box-shadow: var(--shadow-sm);
    color: var(--ink-soft);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.02em;
    cursor: pointer;
    opacity: 0.8;
    transition: opacity 0.2s ease, transform 0.2s ease, border-color 0.2s ease;
  }
  .secret-badge:hover { opacity: 1; transform: translateY(-1px); border-color: var(--accent); }
  .secret-badge .mark { color: var(--accent); }
  .secret-badge.pop { animation: badgePop 0.5s cubic-bezier(0.2, 1.4, 0.4, 1); }
  @keyframes badgePop { 0% { transform: scale(0.6); opacity: 0; } 60% { transform: scale(1.12); } 100% { transform: scale(1); opacity: 0.8; } }

  .secret-panel {
    position: fixed;
    left: 1.4rem;
    bottom: 3.6rem;
    z-index: 191;
    width: min(22rem, calc(100vw - 2.8rem));
    max-height: min(30rem, calc(100vh - 6rem));
    overflow-y: auto;
    background: var(--paper-raised);
    border: 1px solid var(--line);
    border-radius: var(--radius-m);
    box-shadow: var(--shadow-lg);
    padding: 1.05rem 1.1rem 1.15rem;
    transform-origin: bottom left;
    animation: panelIn 0.22s cubic-bezier(0.2, 1, 0.4, 1);
  }
  @keyframes panelIn { from { opacity: 0; transform: translateY(6px) scale(0.98); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) {
    .secret-panel { animation: none; }
    .secret-badge.pop { animation: none; }
  }

  /* panel contents are injected via innerHTML, so descendants need :global */
  .secret-panel :global(h4) { font-size: 1rem; margin: 0 0 0.15rem; }
  .secret-panel :global(.lede) { color: var(--ink-soft); font-size: 0.82rem; line-height: 1.5; margin: 0 0 0.85rem; }
  .secret-panel :global(ul) { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.6rem; }
  .secret-panel :global(li) { display: flex; gap: 0.55rem; font-size: 0.84rem; line-height: 1.5; }
  .secret-panel :global(li .glyph) { flex: none; width: 1rem; text-align: center; }
  .secret-panel :global(li.got .glyph) { color: var(--accent); }
  .secret-panel :global(li.got .body) { color: var(--ink); }
  .secret-panel :global(li.hide .glyph) { color: var(--ink-faint); }
  .secret-panel :global(li.hide .body) { color: var(--ink-faint); font-style: italic; }
  .secret-panel :global(.finale) {
    margin-top: 0.95rem;
    padding-top: 0.85rem;
    border-top: 1px dashed var(--line);
    font-size: 0.84rem;
    line-height: 1.55;
    color: var(--ink);
  }
  .secret-panel :global(.finale a) { color: var(--accent-ink); font-weight: 560; }
  .secret-panel :global(.close) {
    position: absolute;
    top: 0.7rem;
    right: 0.75rem;
    background: none;
    border: none;
    color: var(--ink-faint);
    font-size: 1.1rem;
    line-height: 1;
    cursor: pointer;
    padding: 0.15rem;
  }
  .secret-panel :global(.close:hover) { color: var(--ink); }
</style>

<script>
  const AR = ["#EF0107", "#FFFDF8", "#9C824A", "#C1452A", "#023474"];
  const LS_KEY = "secrets_found_v1";

  // Each secret reveals a small, true thing about me. Order = panel order.
  const SECRETS = [
    { id: "coyg",    teaser: "something for the Gooners",
      note: "COYG. i've followed Arsenal through enough heartbreak to call it a personality trait, not a hobby." },
    { id: "konami",  teaser: "muscle memory, if you grew up with a controller",
      note: "the Konami code. of course you tried it. some reflexes never really leave." },
    { id: "aces",    teaser: "for the card players",
      note: "pocket aces. i host a poker night in San Jose, roughly biweekly. there's a seat if you want in." },
    { id: "padel",   teaser: "my current obsession. five letters, type it anywhere",
      note: "padel. i genuinely cannot stop. if you play around the south bay, let's rally." },
    { id: "console", teaser: "some things only show up for people who open the console",
      note: "you ran something in the console. eight years in ML, most recently at Meta, now teaching small models to read San Francisco parking signs. run hire() if you mean it." },
  ];
  const FINALE = "that is all of them. you clearly like poking at things, which is most of what i do too. i'm <a href=\"mailto:shubhamgoel27@gmail.com\">shubhamgoel27@gmail.com</a>, and the poker table always has room.";

  const reduce = () => matchMedia("(prefers-reduced-motion: reduce)").matches;

  function getFound(): string[] {
    try { return JSON.parse(localStorage.getItem(LS_KEY) || "[]"); } catch (e) { return []; }
  }
  function saveFound(list: string[]) {
    try { localStorage.setItem(LS_KEY, JSON.stringify(list)); } catch (e) {}
  }

  function toast(msg: string) {
    const el = document.getElementById("secret-toast");
    if (!el) return;
    el.textContent = msg;
    el.classList.add("show");
    clearTimeout((el as any)._t);
    (el as any)._t = setTimeout(() => el.classList.remove("show"), 2600);
  }

  function confetti(colors: string[], n = 44) {
    if (reduce()) return;
    const cx = innerWidth / 2, cy = innerHeight / 2.4;
    for (let i = 0; i < n; i++) {
      const p = document.createElement("span");
      p.style.cssText = `position:fixed;left:${cx}px;top:${cy}px;width:9px;height:9px;border-radius:2px;pointer-events:none;z-index:999;will-change:transform,opacity;background:${colors[i % colors.length]}`;
      document.body.appendChild(p);
      const ang = Math.random() * Math.PI * 2;
      const v = 120 + Math.random() * 260;
      p.animate(
        [
          { transform: "translate(0,0) rotate(0)", opacity: 1 },
          { transform: `translate(${Math.cos(ang) * v}px, ${Math.sin(ang) * v - 120 + 260}px) rotate(${Math.random() * 720}deg)`, opacity: 0 },
        ],
        { duration: 1100 + Math.random() * 700, easing: "cubic-bezier(0.2,0.6,0.3,1)" }
      ).onfinish = () => p.remove();
    }
  }

  // Reflect current progress onto whatever DOM is on-screen now (re-runs per page).
  function renderBadge() {
    const badge = document.getElementById("secret-badge");
    const count = document.getElementById("secret-count");
    if (!badge || !count) return;
    const found = getFound().filter((id) => SECRETS.some((s) => s.id === id));
    if (found.length === 0) { badge.hidden = true; return; }
    badge.hidden = false;
    count.textContent = found.length >= SECRETS.length ? "all found" : `${found.length} / ${SECRETS.length}`;
  }

  function buildPanel() {
    const panel = document.getElementById("secret-panel");
    if (!panel) return;
    const found = new Set(getFound());
    const items = SECRETS.map((s) => {
      const got = found.has(s.id);
      return `<li class="${got ? "got" : "hide"}"><span class="glyph">${got ? "✦" : "·"}</span><span class="body">${got ? s.note : s.teaser}</span></li>`;
    }).join("");
    const complete = SECRETS.every((s) => found.has(s.id));
    panel.innerHTML =
      `<button class="close" type="button" aria-label="Close">×</button>` +
      `<h4>a few little things</h4>` +
      `<p class="lede">tucked around this site, mostly excuses to tell you something about me. no pressure to find them all.</p>` +
      `<ul>${items}</ul>` +
      (complete ? `<p class="finale">${FINALE}</p>` : "");
    panel.querySelector(".close")?.addEventListener("click", closePanel);
  }

  function openPanel() {
    const panel = document.getElementById("secret-panel");
    const badge = document.getElementById("secret-badge");
    if (!panel) return;
    buildPanel();
    panel.hidden = false;
    badge?.setAttribute("aria-expanded", "true");
  }
  function closePanel() {
    const panel = document.getElementById("secret-panel");
    const badge = document.getElementById("secret-badge");
    if (panel) panel.hidden = true;
    badge?.setAttribute("aria-expanded", "false");
  }

  function markFound(id: string) {
    const found = getFound();
    if (found.includes(id)) return; // already had it, no repeat celebration
    found.push(id);
    saveFound(found);
    renderBadge();
    const badge = document.getElementById("secret-badge");
    if (badge && !reduce()) { badge.classList.remove("pop"); void (badge as any).offsetWidth; badge.classList.add("pop"); }
    const valid = found.filter((f) => SECRETS.some((s) => s.id === f));
    if (valid.length >= SECRETS.length) {
      setTimeout(() => { toast("that's all of them ✦ tap the mark, bottom-left"); }, 900);
    }
  }

  function pocketAces() {
    const c1 = document.getElementById("pcard-1");
    const c2 = document.getElementById("pcard-2");
    if (c1 && c2) {
      c1.textContent = "A♠"; c2.textContent = "A♥";
      c1.className = "pcard black"; c2.className = "pcard red";
      document.getElementById("hand")?.classList.add("paired");
    }
    confetti(AR, 40);
    toast("pocket aces. dealer's choice.");
    markFound("aces");
  }
  function coyg() {
    confetti(["#EF0107", "#FFFDF8", "#C1452A"], 56);
    toast("⚽ COME ON YOU GUNNERS");
    markFound("coyg");
  }

  // ambient eggs (not part of the tracked collection), just for fun
  function steam() {
    toast("chai o'clock ☕");
    if (reduce()) return;
    const cx = innerWidth / 2, cy = innerHeight - 80;
    for (let i = 0; i < 10; i++) {
      const s = document.createElement("span");
      s.style.cssText = `position:fixed;left:${cx + (Math.random() * 44 - 22)}px;top:${cy}px;width:${6 + Math.random() * 6}px;height:${6 + Math.random() * 6}px;border-radius:50%;background:color-mix(in srgb, var(--ink) 22%, transparent);filter:blur(1px);pointer-events:none;z-index:999`;
      document.body.appendChild(s);
      s.animate(
        [
          { transform: "translate(0,0) scale(0.6)", opacity: 0 },
          { opacity: 0.55, offset: 0.2 },
          { transform: `translate(${Math.random() * 40 - 20}px, -${150 + Math.random() * 120}px) scale(1.4)`, opacity: 0 },
        ],
        { duration: 1800 + Math.random() * 900, easing: "ease-out", delay: i * 80 }
      ).onfinish = () => s.remove();
    }
  }
  function rollBall() {
    if (reduce()) { toast("⚽ gg"); return; }
    const b = document.createElement("span");
    b.textContent = "⚽";
    b.style.cssText = "position:fixed;left:0;bottom:18px;font-size:38px;line-height:1;pointer-events:none;z-index:999;will-change:transform";
    document.body.appendChild(b);
    const dist = innerWidth + 90;
    b.animate(
      [{ transform: "translateX(-70px) rotate(0deg)" }, { transform: `translateX(${dist}px) rotate(${dist / 9}deg)` }],
      { duration: 1650, easing: "cubic-bezier(0.3,0,0.55,1)" }
    ).onfinish = () => b.remove();
  }

  // ---- one-time setup: global listeners + console greeting ----
  function initSecretsOnce() {
    if ((window as any).__secrets) return;
    (window as any).__secrets = true;

    (window as any).__party = coyg; // used by the command palette

    const KONAMI = "ArrowUp,ArrowUp,ArrowDown,ArrowDown,ArrowLeft,ArrowRight,ArrowLeft,ArrowRight,b,a";
    let konami: string[] = [];
    let typed = "";

    addEventListener("keydown", (e) => {
      if (e.key === "Escape") closePanel();

      konami.push(e.key);
      konami = konami.slice(-10);
      if (konami.join(",") === KONAMI) {
        confetti(AR, 80);
        toast("⬆⬆⬇⬇⬅➡⬅➡ B A  ·  up the Arsenal.");
        markFound("konami");
        konami = [];
        return;
      }

      if (e.key.length === 1 && /[a-z]/i.test(e.key)) {
        const el = document.activeElement as HTMLElement | null;
        if (el && /^(INPUT|TEXTAREA)$/.test(el.tagName)) return; // don't fire while typing in a field
        typed = (typed + e.key.toLowerCase()).slice(-6);
        if (typed.endsWith("coyg")) coyg();
        else if (typed.endsWith("aaaa")) pocketAces();
        else if (typed.endsWith("padel")) {
          confetti(["#C1452A", "#9C824A", "#023474"], 36);
          toast("🎾 padel. can't stop won't stop.");
          markFound("padel");
        }
        else if (typed.endsWith("chai")) steam();
        else if (typed.endsWith("gg")) rollBall();
      }
    });

    // close the panel when clicking outside it
    addEventListener("click", (e) => {
      const panel = document.getElementById("secret-panel");
      const badge = document.getElementById("secret-badge");
      if (!panel || panel.hidden) return;
      const t = e.target as Node;
      if (panel.contains(t) || badge?.contains(t)) return;
      closePanel();
    });

    // a note for the kind of person who opens this
    const big = "font:600 15px/1.5 Georgia,serif;color:#C1452A";
    const dim = "font:400 12px/1.5 ui-monospace,monospace;color:#8a8178";
    const code = "font:600 12px/1.5 ui-monospace,monospace;color:#023474";
    console.log("%cwell hello, fellow console-opener 👋", big);
    console.log("%cyou clearly poke at things. so do i. try one of these:", dim);
    console.log("%c  hire()%c    if you're hiring an ML engineer", code, dim);
    console.log("%c  coyg()%c    if you know, you know", code, dim);
    console.log("%c  secrets()%c how many little things you've found", code, dim);

    (window as any).hire = () => {
      markFound("console");
      console.log("%c8 yrs in ML, ex-Meta, now teaching small VLMs to read SF parking signs.", "font:400 13px/1.6 Georgia,serif;color:#2B2521");
      return "shubhamgoel27@gmail.com — let's talk. (also: shubham.gg/resume)";
    };
    (window as any).coyg = () => { markFound("console"); coyg(); return "⚽"; };
    (window as any).secrets = () => {
      markFound("console");
      const n = getFound().filter((f) => SECRETS.some((s) => s.id === f)).length;
      return `${n} / ${SECRETS.length} found. the rest are hiding in plain sight.`;
    };
  }

  // ---- per-page: wire the freshly-rendered badge/panel to current state ----
  function syncSecretsUI() {
    renderBadge();
    const badge = document.getElementById("secret-badge");
    if (badge && !(badge as any)._wired) {
      (badge as any)._wired = true;
      badge.addEventListener("click", () => {
        const panel = document.getElementById("secret-panel");
        if (panel && !panel.hidden) closePanel(); else openPanel();
      });
    }
  }

  function boot() { initSecretsOnce(); syncSecretsUI(); }
  boot();
  document.addEventListener("astro:page-load", boot);
</script>
