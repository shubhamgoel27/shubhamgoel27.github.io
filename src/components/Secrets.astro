---
// Global keyboard easter eggs. Type COYG, the Konami code, or AAAA.
---
<div id="secret-toast" class="secret-toast" role="status" aria-live="polite"></div>

<style>
  .secret-toast {
    position: fixed;
    left: 50%;
    bottom: 2rem;
    transform: translate(-50%, 1rem);
    background: var(--ink);
    color: var(--paper);
    padding: 0.6rem 1rem;
    border-radius: var(--radius-pill);
    font-size: 0.9rem;
    font-weight: 540;
    box-shadow: var(--shadow-lg);
    opacity: 0;
    pointer-events: none;
    z-index: 200;
    transition: opacity 0.25s ease, transform 0.35s cubic-bezier(0.2, 1.3, 0.4, 1);
    white-space: nowrap;
  }
  .secret-toast.show { opacity: 1; transform: translate(-50%, 0); }
</style>

<script>
  function initSecrets() {
    if ((window as any).__secrets) return;
    (window as any).__secrets = true;

    const AR = ["#EF0107", "#FFFDF8", "#9C824A", "#C1452A", "#023474"];
    const reduce = () => matchMedia("(prefers-reduced-motion: reduce)").matches;

    function toast(msg: string) {
      const el = document.getElementById("secret-toast");
      if (!el) return;
      el.textContent = msg;
      el.classList.add("show");
      clearTimeout((el as any)._t);
      (el as any)._t = setTimeout(() => el.classList.remove("show"), 2600);
    }

    function confetti(colors: string[], n = 44) {
      if (reduce()) return;
      const cx = innerWidth / 2, cy = innerHeight / 2.4;
      for (let i = 0; i < n; i++) {
        const p = document.createElement("span");
        p.style.cssText = `position:fixed;left:${cx}px;top:${cy}px;width:9px;height:9px;border-radius:2px;pointer-events:none;z-index:999;will-change:transform,opacity;background:${colors[i % colors.length]}`;
        document.body.appendChild(p);
        const ang = Math.random() * Math.PI * 2;
        const v = 120 + Math.random() * 260;
        p.animate(
          [
            { transform: "translate(0,0) rotate(0)", opacity: 1 },
            { transform: `translate(${Math.cos(ang) * v}px, ${Math.sin(ang) * v - 120 + 260}px) rotate(${Math.random() * 720}deg)`, opacity: 0 },
          ],
          { duration: 1100 + Math.random() * 700, easing: "cubic-bezier(0.2,0.6,0.3,1)" }
        ).onfinish = () => p.remove();
      }
    }

    (window as any).__party = () => {
      confetti(["#EF0107", "#FFFDF8", "#C1452A"], 56);
      toast("⚽ COME ON YOU GUNNERS");
    };

    const KONAMI = "ArrowUp,ArrowUp,ArrowDown,ArrowDown,ArrowLeft,ArrowRight,ArrowLeft,ArrowRight,b,a";
    let konami: string[] = [];
    let typed = "";

    addEventListener("keydown", (e) => {
      // Konami (arrows + b + a)
      konami.push(e.key);
      konami = konami.slice(-10);
      if (konami.join(",") === KONAMI) {
        confetti(AR, 80);
        toast("⬆⬆⬇⬇⬅➡⬅➡ B A  ·  up the Arsenal.");
        konami = [];
        return;
      }
      // letter sequences
      if (e.key.length === 1 && /[a-z]/i.test(e.key)) {
        typed = (typed + e.key.toLowerCase()).slice(-6);
        if (typed.endsWith("coyg")) {
          confetti(["#EF0107", "#FFFDF8", "#C1452A"], 56);
          toast("⚽ COME ON YOU GUNNERS");
        } else if (typed.endsWith("aaaa")) {
          const c1 = document.getElementById("pcard-1");
          const c2 = document.getElementById("pcard-2");
          if (c1 && c2) {
            c1.textContent = "A♠"; c2.textContent = "A♥";
            c1.className = "pcard black"; c2.className = "pcard red";
            document.getElementById("hand")?.classList.add("paired");
          }
          confetti(AR, 40);
          toast("pocket aces. dealer's choice.");
        }
      }
    });
  }
  initSecrets();
  document.addEventListener("astro:page-load", initSecrets);
</script>
