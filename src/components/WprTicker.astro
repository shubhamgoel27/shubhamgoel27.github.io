---
// "Every game counts": an even one-set match played out game by game. The meter shows what the set would be
// worth to your rating if it ended right there, using the same model as the calculator.
const SEQ = "ULLLLULU"; // from 4-1 up: go 5-1, switch off, scrape it 7-6
---
<figure class="ticker" data-wpr-ticker data-seq={SEQ}>
  <div class="t-board">
    <div class="t-side"><span class="t-name">You</span><span class="t-g" data-f>4</span></div>
    <span class="t-dash" aria-hidden="true">–</span>
    <div class="t-side"><span class="t-g" data-a>1</span><span class="t-name">Them</span></div>
  </div>

  <div class="t-meter" aria-hidden="true">
    <span class="t-zero"></span>
    <span class="t-fill" data-fill></span>
  </div>
  <p class="t-val"><span data-val>+0.00</span> <small>if the set ended here</small></p>

  <svg class="t-line" viewBox="0 0 260 70" preserveAspectRatio="none" aria-hidden="true">
    <line x1="0" y1="35" x2="260" y2="35" class="t-axis" />
    <polyline data-line points="" />
  </svg>

  <figcaption>
    <span data-cap>An even match, and you're 4-1 up. Watch the number as the set goes on.</span>
    <button type="button" data-play>Play</button>
  </figcaption>
</figure>

<style>
  .ticker { margin: var(--space-m) 0; padding: var(--space-m); border: 1px solid var(--line); border-radius: var(--radius-l); background: var(--paper-raised); }
  .t-board { display: flex; align-items: center; justify-content: center; gap: var(--space-s); }
  .t-side { display: flex; align-items: center; gap: 0.6rem; }
  .t-name { font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-faint); }
  .t-g {
    display: inline-grid; place-items: center; min-width: 3.2rem; height: 3.6rem; border-radius: var(--radius-s);
    background: var(--paper); border: 1px solid var(--line-strong);
    font-family: var(--font-serif); font-size: 2.3rem; font-weight: 600; font-variant-numeric: tabular-nums; color: var(--ink);
  }
  .t-g.pop { animation: t-pop 0.35s ease-out; }
  @keyframes t-pop { 40% { transform: translateY(-5px) scale(1.08); color: var(--accent-ink); } }
  .t-dash { color: var(--ink-faint); font-size: 1.6rem; }

  .t-meter { position: relative; height: 0.6rem; margin: var(--space-m) 0 0.4rem; border-radius: 999px; background: var(--paper); border: 1px solid var(--line); overflow: hidden; }
  .t-zero { position: absolute; left: 50%; top: -2px; bottom: -2px; width: 2px; background: var(--line-strong); }
  .t-fill { position: absolute; top: 0; bottom: 0; left: 50%; width: 0; background: var(--accent); transition: left 0.45s cubic-bezier(.3,.7,.3,1), width 0.45s cubic-bezier(.3,.7,.3,1), background 0.3s; }
  .t-fill.neg { background: var(--ink-faint); }
  .t-val { margin: 0; text-align: center; font-family: var(--font-serif); font-size: 1.5rem; font-weight: 600; font-variant-numeric: tabular-nums; color: var(--accent-ink); }
  .t-val small { font-family: var(--font-sans, inherit); font-size: 0.8rem; font-weight: 400; color: var(--ink-faint); }

  .t-line { display: block; width: 100%; height: 4.4rem; margin-top: var(--space-s); overflow: visible; }
  .t-axis { stroke: var(--line-strong); stroke-dasharray: 3 4; stroke-width: 1; vector-effect: non-scaling-stroke; }
  .t-line polyline { fill: none; stroke: var(--accent); stroke-width: 2.5; stroke-linejoin: round; stroke-linecap: round; vector-effect: non-scaling-stroke; }

  figcaption { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--space-s); margin-top: var(--space-s); font-size: 0.9rem; line-height: 1.5; color: var(--ink-soft); }
  figcaption span { flex: 1 1 18rem; }
  figcaption button {
    font: inherit; font-size: 0.82rem; cursor: pointer; color: var(--accent-ink); background: transparent;
    border: 1px solid var(--accent); border-radius: 999px; padding: 0.3rem 0.9rem;
  }
  figcaption button:hover { background: var(--accent); color: var(--paper); }
  @media (prefers-reduced-motion: reduce) { .t-g.pop { animation: none; } .t-fill { transition: none; } }
</style>

<script>
  import { change, fmt } from "../lib/wpr";

  function initTicker(root: HTMLElement) {
    if ((root as any)._wired) return;
    (root as any)._wired = true;
    const seq = root.dataset.seq!;
    const $ = (s: string) => root.querySelector<HTMLElement>(s)!;
    const fEl = $("[data-f]"), aEl = $("[data-a]"), fill = $("[data-fill]"), val = $("[data-val]");
    const line = root.querySelector("polyline")!;
    const cap = $("[data-cap]"), btn = root.querySelector<HTMLButtonElement>("[data-play]")!;

    // running score and set value after each game
    const value = (f: number, a: number) => change({ me: 3.4, gap: 0, n: 40, win: f > a ? 1 : f < a ? 0 : 0.5, share: f / (f + a) });
    let f = 4, a = 1;
    const steps = [{ f, a, v: value(f, a) }];
    for (const g of seq) {
      g === "U" ? f++ : a++;
      steps.push({ f, a, v: value(f, a) });
    }
    const MAX = 0.11;
    const x = (i: number) => (i / (steps.length - 1)) * 260;
    const y = (v: number) => 35 - (v / MAX) * 32;
    const peak = steps.reduce((p, s) => (s.v > p.v ? s : p));
    const last = steps[steps.length - 1];

    const show = (i: number) => {
      const s = steps[i], prev = steps[i - 1];
      if (prev && s.f !== prev.f) { fEl.classList.remove("pop"); void fEl.offsetWidth; fEl.classList.add("pop"); }
      if (prev && s.a !== prev.a) { aEl.classList.remove("pop"); void aEl.offsetWidth; aEl.classList.add("pop"); }
      fEl.textContent = String(s.f); aEl.textContent = String(s.a);
      const w = (Math.min(Math.abs(s.v), MAX) / MAX) * 50;
      fill.style.left = s.v >= 0 ? "50%" : `${50 - w}%`;
      fill.style.width = `${w}%`;
      fill.classList.toggle("neg", s.v < 0);
      val.textContent = fmt(s.v);
      line.setAttribute("points", steps.slice(0, i + 1).map((t, j) => `${x(j)},${y(t.v)}`).join(" "));
      if (i === steps.length - 1)
        cap.textContent = `At ${peak.f}-${peak.a} this set was worth ${fmt(peak.v)}. Coasting home to ${last.f}-${last.a} left ${fmt(last.v)}. Same win, about a third of the rating.`;
    };

    let timer = 0;
    const play = () => {
      clearInterval(timer);
      if (matchMedia("(prefers-reduced-motion: reduce)").matches) { show(steps.length - 1); return; }
      let i = 0; show(0);
      cap.textContent = "An even match, and you're 4-1 up. Watch the number as the set goes on.";
      btn.textContent = "Replay";
      timer = window.setInterval(() => { i++; show(i); if (i >= steps.length - 1) clearInterval(timer); }, 700);
    };
    btn.addEventListener("click", play);
    const io = new IntersectionObserver((es) => { if (es[0].isIntersecting) { io.disconnect(); play(); } }, { threshold: 0.6 });
    io.observe(root);
    document.addEventListener("astro:before-swap", () => { clearInterval(timer); io.disconnect(); }, { once: true });
  }
  const boot = () => document.querySelectorAll<HTMLElement>("[data-wpr-ticker]").forEach(initTicker);
  boot();
  document.addEventListener("astro:page-load", boot);
</script>
