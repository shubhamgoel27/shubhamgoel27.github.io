---
// Hand-drawn self-portrait doodle for the hero. Single-weight terracotta line art
// in the same language as the squiggle: theme-aware (CSS vars), a feDisplacementMap
// "roughen" filter for a hand-sketched wobble, and a gentle fade-in + idle float.
---
<div class="doodle-wrap" aria-hidden="true">
  <svg class="doodle" viewBox="0 0 340 340" fill="none" role="img" aria-label="A hand-drawn doodle of Shubham with a football">
    <defs>
      <filter id="hd-rough" x="-18%" y="-18%" width="136%" height="136%">
        <feTurbulence type="fractalNoise" baseFrequency="0.016" numOctaves="2" seed="6" result="n"/>
        <feDisplacementMap in="SourceGraphic" in2="n" scale="3.2"/>
      </filter>
    </defs>
    <ellipse class="wash" cx="170" cy="156" rx="98" ry="102"/>
    <g filter="url(#hd-rough)">
      <path class="stroke" d="M92 302 C96 252 120 226 170 226 C220 226 244 252 248 302"/>
      <path class="stroke" d="M108 148 C108 104 134 78 170 78 C206 78 232 106 232 146 C232 188 208 214 170 214 C132 214 108 190 108 148Z"/>
      <path class="stroke thin" d="M108 150 C99 152 99 166 108 168"/>
      <path class="stroke thin" d="M232 148 C241 150 241 164 232 166"/>
      <path class="hair" d="M104 158 C98 130 96 102 110 78 C126 54 152 54 157 68 C163 60 169 60 175 70 C183 60 193 58 199 70 C215 56 236 60 242 88 C250 114 248 134 236 158 C230 134 224 122 214 116 C202 108 194 114 184 114 C175 120 165 116 155 112 C142 108 129 112 121 120 C114 126 108 138 104 158Z"/>
      <path class="stroke thin flick" d="M140 60 C137 48 147 45 151 57"/>
      <path class="stroke thin flick" d="M196 60 C201 47 211 50 208 62"/>
      <path class="stroke thin flick" d="M170 54 C169 44 176 43 179 53"/>
      <rect class="stroke" x="120" y="132" width="42" height="34" rx="15"/>
      <rect class="stroke" x="178" y="132" width="42" height="34" rx="15"/>
      <path class="stroke thin" d="M162 147 C168 143 172 143 178 147"/>
      <path class="stroke thin" d="M120 144 L108 142"/>
      <path class="stroke thin" d="M220 144 L232 142"/>
      <path class="mouth" d="M150 188 C161 199 179 199 190 188 C179 199 161 199 150 188 Z"/>
      <!-- laptop showing an eval chart ticking up (building) -->
      <g class="laptop">
        <rect class="stroke thin" x="28" y="236" width="56" height="36" rx="3"/>
        <path class="stroke thin chart" d="M37 263 L46 254 L54 258 L63 247 L71 250 L78 242"/>
        <path class="stroke thin" d="M28 272 L84 272 L93 285 L19 285 Z"/>
        <path class="stroke thin" d="M48 279 H64"/>
      </g>
      <!-- football (futbol / Arsenal) -->
      <g class="ball">
        <circle class="stroke" cx="262" cy="264" r="31"/>
        <path class="stroke thin" d="M262 247 L249 257 L254 273 L270 273 L275 257 Z"/>
        <path class="stroke thin" d="M262 247 V237 M249 257 L237 253 M254 273 L248 285 M270 273 L276 285 M275 257 L287 253"/>
      </g>
      <!-- poker card (top-left, jaunty tilt) -->
      <g class="card" transform="rotate(-11 60 98)">
        <rect class="paper-fill" x="45" y="76" width="31" height="44" rx="5"/>
        <path class="fill-accent" d="M60 92 C57 87 49 88 49 95 C49 102 60 108 60 108 C60 108 71 102 71 95 C71 88 63 87 60 92Z"/>
        <path class="fill-accent thin2" d="M50 82 C49 80 46 80 46 83 C46 86 50 88 50 88 C50 88 54 86 54 83 C54 80 51 80 50 82Z"/>
      </g>
      <!-- coffee (building fuel) -->
      <g class="mug">
        <path class="stroke thin" d="M283 108 L285 131 C285 134 287 136 290 136 L300 136 C303 136 305 134 305 131 L307 108Z"/>
        <path class="stroke thin" d="M307 113 C315 113 315 126 306 126"/>
        <path class="stroke thin steam" d="M290 102 C287 98 293 94 290 90"/>
        <path class="stroke thin steam" d="M300 102 C297 98 303 94 300 90"/>
      </g>
    </g>
    <circle class="dot pupil" id="pupil-l" cx="141" cy="150" r="3.3"/>
    <circle class="dot pupil" id="pupil-r" cx="199" cy="150" r="3.3"/>
    <!-- squeezed-shut eyes, shown only during the yawn -->
    <path class="clench-eye" d="M132 152 C136 145 146 145 150 152" aria-hidden="true"/>
    <path class="clench-eye" d="M190 152 C194 145 204 145 208 152" aria-hidden="true"/>
    <!-- hover easter egg: a little Arsenal shout -->
    <g class="coyg" aria-hidden="true">
      <circle class="coyg-b" cx="240" cy="60" r="3"/>
      <circle class="coyg-b" cx="251" cy="50" r="5"/>
      <ellipse class="coyg-b" cx="288" cy="30" rx="47" ry="18"/>
      <text class="coyg-t" x="288" y="37" text-anchor="middle">COYG!</text>
    </g>
    <!-- shown when he nods off after a while -->
    <g class="zzz" aria-hidden="true">
      <text class="zzz-t z1" x="246" y="98">z</text>
      <text class="zzz-t z2" x="262" y="82">z</text>
      <text class="zzz-t z3" x="282" y="64">z</text>
    </g>
    <!-- brief reaction when the theme is toggled: yawn for dark, sparkle for light -->
    <text class="yawn-z" x="214" y="150" aria-hidden="true">z</text>
    <g class="wake-spark" aria-hidden="true">
      <path class="stroke thin" d="M250 92 L250 108 M242 100 L258 100"/>
    </g>
  </svg>
</div>

<style>
  .doodle-wrap { display: flex; justify-content: center; }
  .doodle {
    width: min(23rem, 100%);
    height: auto;
    overflow: visible;
    animation: doodle-in 0.9s var(--ease, cubic-bezier(0.2, 0.7, 0.2, 1)) 0.15s both,
               doodle-float 7s ease-in-out 1s infinite;
  }
  .stroke { stroke: var(--accent); stroke-width: 3.3; stroke-linecap: round; stroke-linejoin: round; fill: none; }
  .thin   { stroke-width: 2.3; }
  .ink    { stroke: var(--ink); }
  .wash   { fill: var(--accent-wash); stroke: none; }
  .hair   { fill: var(--paper); stroke: var(--accent); stroke-width: 3.3; stroke-linejoin: round; }
  .dot    { fill: var(--accent); stroke: none; }
  .pupil  { transform-box: fill-box; transform-origin: center; transition: transform 0.12s ease-out; }
  .paper-fill  { fill: var(--paper); stroke: var(--accent); stroke-width: 2.3; stroke-linejoin: round; }
  .fill-accent { fill: var(--accent); stroke: none; }
  .steam       { animation: steam 3.4s ease-in-out infinite; transform-box: fill-box; transform-origin: bottom; }
  @keyframes steam { 0%, 100% { opacity: 0.3; transform: translateY(2px); } 50% { opacity: 0.9; transform: translateY(-2px); } }

  .ball    { transform-box: fill-box; transform-origin: center; animation: ball-bob 3.2s ease-in-out infinite; }

  /* hover easter egg */
  .coyg { opacity: 0; transform: translateY(8px) scale(0.7); transform-box: fill-box; transform-origin: 70% bottom; transition: opacity 0.22s var(--ease, ease), transform 0.32s cubic-bezier(0.2, 1.4, 0.4, 1); }
  .coyg-b { fill: var(--paper); stroke: var(--accent); stroke-width: 2.3; }
  .coyg-t { fill: var(--accent); font-family: var(--font-sans, sans-serif); font-weight: 700; font-size: 20px; letter-spacing: 0.5px; }
  .doodle-wrap:hover .coyg { opacity: 1; transform: none; }
  .doodle-wrap:hover .ball { animation: ball-spin 1.05s linear infinite; }
  @keyframes ball-spin { to { transform: rotate(360deg); } }
  .sparkle { animation: twinkle 3s ease-in-out infinite; transform-box: fill-box; transform-origin: center; }

  /* idle sleep: eyes close (via JS) and little z's drift up. z's hidden until sleeping */
  .zzz-t { fill: var(--accent); font-family: var(--font-serif, serif); font-style: italic; font-weight: 700; opacity: 0; }
  .z1 { font-size: 15px; } .z2 { font-size: 20px; } .z3 { font-size: 26px; }
  .doodle.sleeping { animation-play-state: paused; }
  .doodle.sleeping .zzz-t { transform-box: fill-box; animation: zfloat 2.6s ease-in-out infinite; }
  .doodle.sleeping .z2 { animation-delay: 0.5s; }
  .doodle.sleeping .z3 { animation-delay: 1s; }
  @keyframes zfloat { 0% { opacity: 0; transform: translateY(5px) rotate(-4deg); } 35% { opacity: 1; } 100% { opacity: 0; transform: translateY(-12px) rotate(6deg); } }

  /* theme-toggle reactions: the smile opens into a yawn for dark, a sparkle for light */
  .mouth { fill: var(--ink); fill-opacity: 0; stroke: var(--accent); stroke-width: 3.3; stroke-linecap: round; stroke-linejoin: round; }
  .doodle.reacting-dark .mouth { animation: doodle-yawn 1.4s ease; }
  @keyframes doodle-yawn {
    0%, 100% { d: path("M150 188 C161 199 179 199 190 188 C179 199 161 199 150 188 Z"); fill-opacity: 0; }
    24%, 76% { d: path("M157 191 C157 179 183 179 183 191 C183 209 157 209 157 191 Z"); fill-opacity: 0.9; }
  }

  /* eyes squeeze shut during the yawn: pupils fade out, clenched arcs fade in */
  .clench-eye { stroke: var(--accent); stroke-width: 2.8; stroke-linecap: round; fill: none; opacity: 0; }
  .doodle.reacting-dark .clench-eye { animation: doodle-clench 1.4s ease; }
  @keyframes doodle-clench { 0%, 100% { opacity: 0; } 24%, 76% { opacity: 1; } }
  .doodle.reacting-dark .pupil { animation: doodle-pupilhide 1.4s ease; }
  @keyframes doodle-pupilhide { 0%, 100% { opacity: 1; } 24%, 76% { opacity: 0; } }

  .yawn-z { fill: var(--accent); font-family: var(--font-serif, serif); font-style: italic; font-weight: 700; font-size: 18px; opacity: 0; transform-box: fill-box; }
  .doodle.reacting-dark .yawn-z { animation: doodle-yawnz 1.4s ease; }
  @keyframes doodle-yawnz { 0% { opacity: 0; transform: translate(0, 4px); } 35% { opacity: 1; } 100% { opacity: 0; transform: translate(7px, -16px); } }

  .wake-spark { opacity: 0; transform-box: fill-box; transform-origin: 250px 100px; }
  .doodle.reacting-light .wake-spark { animation: doodle-wake 0.95s ease; }
  @keyframes doodle-wake { 0%, 100% { opacity: 0; transform: scale(0.3) rotate(0deg); } 45% { opacity: 1; transform: scale(1.1) rotate(30deg); } }

  @keyframes doodle-in { from { opacity: 0; transform: translateY(14px) rotate(-1.5deg); } to { opacity: 1; transform: none; } }
  @keyframes doodle-float { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-7px); } }
  @keyframes ball-bob { 0%, 100% { transform: translateY(0) rotate(0); } 50% { transform: translateY(-6px) rotate(8deg); } }
  @keyframes twinkle { 0%, 100% { opacity: 0.35; transform: scale(0.85); } 50% { opacity: 1; transform: scale(1.1); } }

  @media (prefers-reduced-motion: reduce) {
    .doodle, .ball, .sparkle { animation: none; }
    .doodle.sleeping .zzz-t { animation: none; opacity: 0.85; }
  }
</style>

<script>
  // The doodle's pupils follow the cursor, and he blinks now and then.
  function initDoodleEyes() {
    const svg = document.querySelector(".doodle") as SVGElement | null;
    const pl = document.getElementById("pupil-l");
    const pr = document.getElementById("pupil-r");
    if (!svg || !pl || !pr || svg.dataset.eyes) return;
    svg.dataset.eyes = "1";
    const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
    let ox = 0, oy = 0, blink = 1, sleeping = false, idleTimer: ReturnType<typeof setTimeout>;
    const apply = () => {
      const t = `translate(${ox}px, ${oy}px) scaleY(${sleeping ? 0.06 : blink})`;
      pl.style.transform = t;
      pr.style.transform = t;
    };

    // nod off after a spell of no activity; wake on any interaction
    const sleep = () => { sleeping = true; svg.classList.add("sleeping"); apply(); };
    const wake = () => { if (!sleeping) return; sleeping = false; svg.classList.remove("sleeping"); apply(); };
    const resetIdle = () => { wake(); clearTimeout(idleTimer); idleTimer = setTimeout(sleep, 30000); };
    (window as any).__doodleReset = resetIdle;
    if (!(window as any).__doodleActivity) {
      (window as any).__doodleActivity = true;
      ["scroll", "keydown", "touchstart", "pointerdown"].forEach((ev) =>
        window.addEventListener(ev, () => (window as any).__doodleReset?.(), { passive: true }));
    }

    window.addEventListener("mousemove", (e) => {
      if (!pl.isConnected) return;
      const r = svg.getBoundingClientRect();
      const cx = r.left + r.width / 2;
      const cy = r.top + r.height * 0.42;
      const dx = e.clientX - cx, dy = e.clientY - cy;
      const d = Math.hypot(dx, dy) || 1;
      const max = 3.4;
      ox = (dx / d) * max;
      oy = (dy / d) * max;
      resetIdle();
      apply();
    }, { passive: true });
    resetIdle();

    if (!reduce) {
      const blinkOnce = () => {
        if (!sleeping) { blink = 0.12; apply(); setTimeout(() => { blink = 1; apply(); }, 130); }
        setTimeout(blinkOnce, 2800 + Math.random() * 3800);
      };
      setTimeout(blinkOnce, 2600);
    }
  }
  // brief reaction when the theme flips: yawn into dark, wake into light
  function initDoodleThemeReact() {
    if ((window as any).__doodleThemeReact) return;
    (window as any).__doodleThemeReact = true;
    const root = document.documentElement;
    let last = root.getAttribute("data-theme");
    new MutationObserver(() => {
      const now = root.getAttribute("data-theme");
      if (now === last) return;
      last = now;
      const svg = document.querySelector(".doodle") as SVGElement | null;
      if (!svg || matchMedia("(prefers-reduced-motion: reduce)").matches) return;
      const cls = now === "dark" ? "reacting-dark" : "reacting-light";
      svg.classList.remove("reacting-dark", "reacting-light");
      void (svg as any).offsetWidth;
      svg.classList.add(cls);
      clearTimeout((svg as any).__reactT);
      (svg as any).__reactT = setTimeout(() => svg.classList.remove(cls), 1500);
    }).observe(root, { attributes: true, attributeFilter: ["data-theme"] });
  }

  initDoodleEyes();
  initDoodleThemeReact();
  document.addEventListener("astro:page-load", initDoodleEyes);
</script>
