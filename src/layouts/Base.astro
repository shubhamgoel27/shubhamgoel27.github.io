---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Secrets from "../components/Secrets.astro";
import CommandPalette from "../components/CommandPalette.astro";
import { ClientRouter } from "astro:transitions";
import frauncesWoff2 from "@fontsource-variable/fraunces/files/fraunces-latin-wght-normal.woff2?url";
import interWoff2 from "@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url";

interface Props {
  title?: string;
  description?: string;
  ogType?: string;
  ogImage?: string;
}
const {
  title = "Shubham Goel",
  description = "Machine learning engineer building systems where vision, language, and ranking meet. Previously a Senior MLE at Meta.",
  ogType = "website",
  ogImage = "/og.png",
} = Astro.props;

const fullTitle = title === "Shubham Goel" ? title : `${title} · Shubham Goel`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImageUrl = new URL(ogImage, Astro.site).href;

// One canonical Person entity, homepage only, so search engines link the profile.
const isHome = Astro.url.pathname === "/" || Astro.url.pathname === "";
const personLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Shubham Goel",
  url: new URL("/", Astro.site).href,
  image: ogImageUrl,
  jobTitle: "Machine Learning Engineer",
  description:
    "Machine learning engineer building systems where vision, language, and ranking meet. Previously a Senior Machine Learning Engineer at Meta.",
  knowsAbout: [
    "Machine Learning",
    "Computer Vision",
    "Vision-Language Models",
    "Multimodal Learning",
    "Recommender Systems",
    "Deep Learning",
  ],
  sameAs: [
    "https://github.com/shubhamgoel27",
    "https://www.linkedin.com/in/shubhamgoel27",
    "https://x.com/shubhamg_",
  ],
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {isHome && <script type="application/ld+json" set:html={JSON.stringify(personLd)} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="Shubham Goel" href="/rss.xml" />
    <link rel="preload" as="font" type="font/woff2" href={frauncesWoff2} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={interWoff2} crossorigin />
    <meta name="generator" content={Astro.generator} />
    <ClientRouter />

    <script is:inline>
      // Re-apply theme immediately after a view-transition swap, before paint.
      document.addEventListener("astro:after-swap", function () {
        try {
          var saved = localStorage.getItem("theme");
          var theme = saved || (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
          document.documentElement.setAttribute("data-theme", theme);
        } catch (e) {}
      });
    </script>

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Shubham Goel, machine learning engineer" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:creator" content="@shubhamg_" />

    <script is:inline>
      // No-flash theme init: runs before paint.
      (function () {
        try {
          var saved = localStorage.getItem("theme");
          var theme = saved || (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
          document.documentElement.setAttribute("data-theme", theme);
        } catch (e) {
          document.documentElement.setAttribute("data-theme", "light");
        }
      })();
    </script>

    <!-- Cloudflare Web Analytics (cookieless, privacy-friendly) -->
    <script is:inline type="module" src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "16e6bc570cdd472899c1fd5195880581"}'></script>
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <Secrets />
    <CommandPalette />
  </body>
</html>

<script>
  // Reveal-on-scroll for elements marked .reveal
  function initReveal() {
    const els = document.querySelectorAll(".reveal:not(.in)");
    if (!els.length) return;
    if (!("IntersectionObserver" in window)) {
      els.forEach((e) => e.classList.add("in"));
      return;
    }
    const io = new IntersectionObserver(
      (entries) => {
        for (const en of entries) {
          if (en.isIntersecting) {
            en.target.classList.add("in");
            io.unobserve(en.target);
          }
        }
      },
      { rootMargin: "0px 0px -8% 0px", threshold: 0.06 }
    );
    els.forEach((e) => io.observe(e));
  }
  initReveal();
  document.addEventListener("astro:page-load", initReveal);
</script>
