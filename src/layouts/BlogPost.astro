---
import Base from "./Base.astro";

interface PostRef { slug: string; title: string; }
interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  tags?: string[];
  minutesRead?: number;
  ogImage?: string;
  prev?: PostRef;
  slug?: string;
  next?: PostRef;
}
const { title, description, pubDate, updatedDate, tags = [], minutesRead, ogImage, prev, next, slug } = Astro.props;
const site = Astro.site ?? new URL("https://shubham.gg");
const postUrl = new URL(Astro.url.pathname, site).href;
const articleLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  description,
  url: postUrl,
  mainEntityOfPage: postUrl,
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  image: new URL(ogImage ?? "/og.png", site).href,
  keywords: tags.join(", "),
  inLanguage: "en",
  author: { "@type": "Person", "@id": "https://shubham.gg/#person", name: "Shubham Goel", url: "https://shubham.gg/" },
  publisher: { "@type": "Person", "@id": "https://shubham.gg/#person", name: "Shubham Goel" },
};
const fmt = (d: Date) => d.toLocaleDateString("en-US", { timeZone: "UTC", year: "numeric", month: "long", day: "numeric" });
---
<Base title={title} description={description} ogType="article" ogImage={ogImage}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(articleLd)} />
    <meta property="article:published_time" content={pubDate.toISOString()} />
    {updatedDate && <meta property="article:modified_time" content={updatedDate.toISOString()} />}
    <meta property="article:author" content="Shubham Goel" />
    {tags.map((t) => <meta property="article:tag" content={t} />)}
    {slug && <link rel="alternate" type="text/markdown" title="Markdown version" href={`/blog/${slug}.md`} />}
  </Fragment>
  <div class="read-progress" aria-hidden="true"><span id="read-bar"></span></div>
  <article class="wrap narrow post">
    <header class="post-head">
      <a href="/blog" class="back link-underline">← Writing</a>
      <h1 transition:name={slug ? `post-title-${slug}` : undefined}>{title}</h1>
      <div class="post-meta">
        <time datetime={pubDate.toISOString()}>{fmt(pubDate)}</time>
        {minutesRead && <><span class="sep">·</span><span>{minutesRead} min read</span></>}
        {updatedDate && <><span class="sep">·</span><span>updated {fmt(updatedDate)}</span></>}
      </div>
      {tags.length > 0 && (
        <ul class="post-tags">{tags.map((t) => <li><a href={`/tags/${t}`} class="tag">#{t}</a></li>)}</ul>
      )}
    </header>
    <div class="prose">
      <slot />
    </div>

    <div class="post-end" id="post-end">
      <p class="signoff-thanks">thanks for reading</p>
      <p class="signoff-name">— Shubham</p>
    </div>

    {(prev || next) && (
      <nav class="post-nav" aria-label="More posts">
        {prev ? (
          <a class="post-nav-link prev" href={`/blog/${prev.slug}`}>
            <span class="dir">← Previous</span>
            <span class="ttl">{prev.title}</span>
          </a>
        ) : <span />}
        {next ? (
          <a class="post-nav-link next" href={`/blog/${next.slug}`}>
            <span class="dir">Next →</span>
            <span class="ttl">{next.title}</span>
          </a>
        ) : <span />}
      </nav>
    )}
  </article>
</Base>

<style>
  .post { padding-top: var(--space-xl); }
  .post-head { margin-bottom: var(--space-l); }
  .back { display: inline-block; font-size: 0.88rem; color: var(--ink-soft); margin-bottom: var(--space-m); }
  .post-head h1 { font-size: var(--step-4); }
  .post-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 0.6em; margin-top: var(--space-s); font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-faint); }
  .post-tags { display: flex; flex-wrap: wrap; gap: 0.4rem; list-style: none; padding: 0; margin-top: var(--space-s); }

  /* reading progress: a thin terracotta line pinned to the very top */
  .read-progress { position: fixed; top: 0; left: 0; right: 0; height: 3px; z-index: 25; pointer-events: none; }
  .read-progress span { display: block; height: 100%; width: 0; background: var(--accent); transition: width 0.08s linear; }

  /* finished-reading sign-off */
  .post-end { margin-top: var(--space-xl); text-align: center; }
  .signoff-thanks { font-family: var(--font-mono); font-size: 0.76rem; letter-spacing: 0.03em; color: var(--ink-faint); }
  .signoff-name {
    font-family: var(--font-serif); font-style: italic; font-weight: 500;
    font-size: 1rem; color: var(--ink-soft);
    margin-top: 0.1rem;
  }

  .post-nav { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-s); margin-top: var(--space-2xl); }
  .post-nav-link {
    display: flex; flex-direction: column; gap: 0.25rem;
    padding: var(--space-s) var(--space-m);
    border: 1px solid var(--line); border-radius: var(--radius-m);
    background: var(--paper-raised); color: var(--ink);
    transition: border-color var(--t-fast), transform var(--t-fast), box-shadow var(--t-norm);
  }
  .post-nav-link:hover { border-color: var(--accent); transform: translateY(-2px); box-shadow: var(--shadow-sm); }
  .post-nav-link.next { text-align: right; }
  .post-nav-link .dir { font-family: var(--font-mono); font-size: 0.72rem; color: var(--accent-ink); }
  .post-nav-link .ttl { font-weight: 560; font-size: 0.95rem; }
  @media (max-width: 34rem) { .post-nav { grid-template-columns: 1fr; } .post-nav-link.next { text-align: left; } }
  @media (prefers-reduced-motion: reduce) { .read-progress span { transition: none; } }
</style>

<style is:global>
  .prose { font-size: var(--step-0); line-height: 1.75; color: var(--ink); }
  .prose > * + * { margin-top: var(--space-s); }
  .prose h2 { font-size: var(--step-2); margin-top: var(--space-l); margin-bottom: var(--space-2xs); }
  .prose h3 { font-size: var(--step-1); margin-top: var(--space-m); }
  .prose p, .prose ul, .prose ol { color: var(--ink); }
  .prose ul, .prose ol { padding-left: 1.4rem; }
  .prose li { margin-bottom: 0.4rem; }
  .prose li::marker { color: var(--accent); }
  .prose strong { font-weight: 640; }
  .prose em { font-style: italic; }
  .prose a { color: var(--accent-ink); }
  .prose blockquote {
    border-left: 3px solid var(--accent);
    padding: 0.2rem 0 0.2rem var(--space-s);
    color: var(--ink-soft);
    font-style: italic;
  }
  .prose code:not(pre code) {
    background: var(--paper-sunk);
    border: 1px solid var(--line);
    padding: 0.1em 0.4em;
    border-radius: var(--radius-s);
    font-size: 0.85em;
  }
  .prose pre {
    background: var(--paper-sunk) !important;
    border: 1px solid var(--line);
    border-radius: var(--radius-m);
    padding: var(--space-s);
    overflow-x: auto;
    font-size: 0.86rem;
    line-height: 1.6;
  }
  .prose img { border-radius: var(--radius-m); border: 1px solid var(--line); margin-block: var(--space-m); }
  .prose hr { border: none; border-top: 1px solid var(--line); margin-block: var(--space-l); }

  /* a short terracotta underline that draws itself when the heading scrolls in */
  .prose h2 { position: relative; }
  .prose h2::after {
    content: ""; position: absolute; left: 0; bottom: -0.35rem; height: 2px; width: 2.4rem;
    background: var(--accent); transform: scaleX(0); transform-origin: left;
    transition: transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .prose h2.drawn::after { transform: scaleX(1); }

  /* hover-to-reveal deep-link anchors on headings */
  .prose h3 { position: relative; }
  .prose .heading-anchor {
    position: absolute; left: -1.1rem; top: 0.06em;
    opacity: 0; text-decoration: none; color: var(--ink-faint); font-weight: 400;
    transition: opacity 0.15s ease;
  }
  .prose h2:hover .heading-anchor, .prose h3:hover .heading-anchor { opacity: 1; }
  .prose .heading-anchor:hover { color: var(--accent-ink); }
  @media (max-width: 40rem) { .prose .heading-anchor { display: none; } }
  @media (prefers-reduced-motion: reduce) { .prose h2::after { transition: none; } }
  /* living tables: numeric cells count up and grow a thin bar when scrolled into view */
  @property --v { syntax: "<number>"; inherits: false; initial-value: 0; }
  .prose td.num {
    font-variant-numeric: tabular-nums;
    min-width: 6.5em;
    padding: 0.35em 0.5em 0.6em;
    background: linear-gradient(var(--accent), var(--accent)) no-repeat left 0.35em bottom 0.3em / calc(5.5em * var(--v)) 2px;
    transition: --v 0.9s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  @media (prefers-reduced-motion: reduce) { .prose td.num { transition: none; } }
  /* image zoom: the post image grows into a fullscreen view via a shared view-transition name */
  .prose img.zoomable { cursor: zoom-in; }
  .zoom-overlay {
    position: fixed; inset: 0; z-index: 400;
    display: grid; place-items: center; padding: 4vh 4vw;
    background: color-mix(in srgb, var(--paper) 90%, transparent);
    backdrop-filter: blur(6px);
    cursor: zoom-out;
  }
  .zoom-overlay img {
    max-width: 92vw; max-height: 88vh; width: auto; height: auto;
    object-fit: contain; margin: 0;
    border-radius: var(--radius-m); box-shadow: var(--shadow-lg);
  }
  ::view-transition-group(zoom-img) { animation-duration: 0.42s; animation-timing-function: cubic-bezier(0.2, 0.8, 0.2, 1); }

  /* highlighter: <mark> phrases get a marker stroke that sweeps in when scrolled to (full with JS off) */
  .prose mark {
    color: inherit;
    padding: 0 0.14em; margin: 0 -0.06em;
    border-radius: 0.25em 0.15em 0.3em 0.2em;
    background: linear-gradient(100deg,
        transparent 0.15em,
        color-mix(in srgb, var(--accent) 28%, transparent) 0.3em,
        color-mix(in srgb, var(--accent) 20%, transparent) calc(100% - 0.3em),
        transparent calc(100% - 0.15em))
      no-repeat 0 65% / 100% 72%;
    -webkit-box-decoration-break: clone; box-decoration-break: clone;
    transition: background-size 0.9s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  html.marks-armed .prose mark:not(.on) { background-size: 0% 72%; }
  @media (prefers-reduced-motion: reduce) { .prose mark { transition: none; } }

  /* ---- typesetting ---- */
  .prose > p:first-child::first-letter {
    float: left;
    font-family: var(--font-serif);
    font-weight: 600;
    font-variation-settings: "opsz" 144;
    font-size: 4.6em;
    line-height: 0.78;
    padding: 0.07em 0.12em 0 0;
    color: var(--accent-ink);
  }
  .prose h2, .prose h3 { font-optical-sizing: auto; letter-spacing: -0.01em; }

  /* figures: images break slightly out of the text column; captions set in italic serif */
  .prose figure { margin: var(--space-l) 0; }
  .prose figure img { margin: 0; width: 100%; height: auto; }
  .prose figcaption {
    margin-top: 0.7rem;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--ink-soft);
    padding-left: 0.9rem;
    border-left: 2px solid var(--accent);
  }
  @media (min-width: 62rem) {
    .prose figure { margin-inline: -4.5rem; }
    .prose figcaption { margin-inline: 4.5rem; }
  }

  /* tables: hairline rules, quiet mono headers */
  .prose .table-wrap { overflow-x: auto; margin: var(--space-m) 0 var(--space-l); -webkit-overflow-scrolling: touch; }
  .prose table { width: 100%; border-collapse: collapse; font-size: 0.93rem; line-height: 1.4; }
  .prose thead th {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--ink-faint);
    padding: 0 0.6em 0.6em;
    border-bottom: 1.5px solid var(--ink);
    vertical-align: bottom;
  }
  .prose tbody td { padding: 0.6em; border-bottom: 1px solid var(--line); color: var(--ink); }
  .prose tbody tr:last-child td { border-bottom: 1.5px solid var(--ink); }
  .prose th:first-child, .prose td:first-child { text-align: left; padding-left: 0; }
  .prose tbody tr { transition: background var(--t-fast); }
  .prose tbody tr:hover { background: color-mix(in srgb, var(--accent) 6%, transparent); }
  .prose td strong { color: var(--accent-ink); }

  /* sidenotes: margin notes on wide screens, tap-to-open on small ones (CSS only) */
  .prose .sn-state { display: none; }
  .prose .sn-ref {
    font-family: var(--font-mono);
    font-size: 0.66em;
    font-weight: 600;
    color: var(--accent-ink);
    vertical-align: super;
    line-height: 0;
    padding: 0 0.12em;
    cursor: pointer;
    user-select: none;
  }
  .prose .sn { display: none; }
  .prose .sn-num {
    font-family: var(--font-mono);
    font-style: normal;
    font-size: 0.72em;
    font-weight: 600;
    color: var(--accent-ink);
    margin-right: 0.4em;
  }
  @media (max-width: 75.99rem) {
    .prose .sn-state:checked + .sn {
      display: block;
      margin: 0.6em 0;
      padding: 0.6em 0.9em;
      border-left: 2px solid var(--accent);
      background: var(--paper-sunk);
      border-radius: 0 var(--radius-s) var(--radius-s) 0;
      font-family: var(--font-serif);
      font-style: italic;
      font-size: 0.9rem;
      line-height: 1.5;
      color: var(--ink-soft);
    }
  }
  @media (min-width: 76rem) {
    .prose .sn {
      display: block;
      float: right;
      clear: right;
      width: 14.5rem;
      margin: 0.35rem -17.5rem 0.8rem 0;
      font-family: var(--font-serif);
      font-style: italic;
      font-size: 0.84rem;
      line-height: 1.5;
      color: var(--ink-soft);
    }
    .prose .sn-ref { cursor: default; }
  }
</style>



<script>
  function updateProgress() {
    const bar = document.getElementById("read-bar");
    if (!bar) return;
    const h = document.documentElement;
    const max = h.scrollHeight - h.clientHeight;
    bar.style.width = (max > 0 ? (h.scrollTop / max) * 100 : 0).toFixed(1) + "%";
  }

  function confettiOnce() {
    if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    const colors = ["#C1452A", "#E07A5F", "#9C824A", "#D9C4A9", "#2B2521"];
    const end = document.getElementById("post-end");
    const r = end?.getBoundingClientRect();
    const cx = r ? r.left + r.width / 2 : innerWidth / 2;
    const cy = r ? r.top + r.height / 2 : innerHeight / 2;
    for (let i = 0; i < 42; i++) {
      const p = document.createElement("span");
      p.style.cssText = `position:fixed;left:${cx}px;top:${cy}px;width:8px;height:8px;border-radius:2px;pointer-events:none;z-index:60;background:${colors[i % colors.length]}`;
      document.body.appendChild(p);
      const ang = Math.random() * Math.PI * 2;
      const v = 80 + Math.random() * 180;
      p.animate(
        [
          { transform: "translate(0,0) rotate(0)", opacity: 1 },
          { transform: `translate(${Math.cos(ang) * v}px, ${Math.sin(ang) * v - 100 + 230}px) rotate(${Math.random() * 720}deg)`, opacity: 0 },
        ],
        { duration: 1000 + Math.random() * 700, easing: "cubic-bezier(0.2,0.6,0.3,1)" }
      ).onfinish = () => p.remove();
    }
  }

  function initPost() {
    const article = document.querySelector(".post");
    if (!article || (article as any)._postWired) return;
    (article as any)._postWired = true;

    // reading progress (one scroll listener, ever; reads the current bar)
    if (!(window as any)._readProgWired) {
      (window as any)._readProgWired = true;
      window.addEventListener("scroll", updateProgress, { passive: true });
      window.addEventListener("resize", updateProgress, { passive: true });
    }
    updateProgress();

    // heading anchors: slugify, assign ids, add a hover-reveal # deep link
    const slugify = (s: string) =>
      s.toLowerCase().trim().replace(/[^\w\s-]/g, "").replace(/\s+/g, "-").replace(/-+/g, "-");
    const used = new Set<string>();
    (Array.from(document.querySelectorAll(".prose h2, .prose h3")) as HTMLElement[]).forEach((h) => {
      const base = h.id || slugify(h.textContent || "");
      if (!base) return;
      let id = base, n = 2;
      while (used.has(id)) id = `${base}-${n++}`;
      used.add(id);
      h.id = id;
      const a = document.createElement("a");
      a.className = "heading-anchor";
      a.href = `#${id}`;
      a.setAttribute("aria-label", "Link to this section");
      a.textContent = "#";
      h.prepend(a);
    });

    // draw the underline as each h2 scrolls into view
    const h2s = Array.from(document.querySelectorAll(".prose h2"));
    if ("IntersectionObserver" in window && h2s.length) {
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add("drawn"); io.unobserve(e.target); } });
      }, { threshold: 0.6 });
      h2s.forEach((h) => io.observe(h));
    }

    // reward for reaching the end: one soft confetti burst
    const end = document.getElementById("post-end");
    if (end && "IntersectionObserver" in window) {
      const io2 = new IntersectionObserver((entries) => {
        if (entries.some((e) => e.isIntersecting)) { io2.disconnect(); confettiOnce(); }
      }, { threshold: 0.9 });
      io2.observe(end);
    }
  }


  // metric tables: count numbers up from zero and grow a bar under each one
  function initTables() {
    const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const NUM = /^\d+(\.\d+)?$/;
    document.querySelectorAll<HTMLTableElement>(".prose table").forEach((table) => {
      if ((table as any)._live) return;
      (table as any)._live = true;
      const rows = Array.from(table.tBodies[0]?.rows ?? []);
      const cols = new Map<number, { cell: HTMLTableCellElement; node: Text; value: number; dec: number }[]>();
      rows.forEach((row) =>
        Array.from(row.cells).forEach((cell, ci) => {
          if (ci === 0) return; // label column
          const text = cell.textContent?.trim() ?? "";
          if (!NUM.test(text)) return;
          const walker = document.createTreeWalker(cell, NodeFilter.SHOW_TEXT);
          let node: Text | null = null;
          while (walker.nextNode()) if ((walker.currentNode.textContent ?? "").trim()) node = walker.currentNode as Text;
          if (!node) return;
          if (!cols.has(ci)) cols.set(ci, []);
          cols.get(ci)!.push({ cell, node, value: parseFloat(text), dec: (text.split(".")[1] ?? "").length });
        })
      );
      const cells = Array.from(cols.values()).flatMap((list) => {
        const max = Math.max(...list.map((c) => c.value));
        const scale = max <= 1 ? 1 : max; // scores are 0..1, counts scale to the column max
        return list.map((c) => ({ ...c, frac: scale ? c.value / scale : 0 }));
      });
      if (!cells.length) return;
      cells.forEach((c) => c.cell.classList.add("num"));

      const fill = () => cells.forEach((c) => c.cell.style.setProperty("--v", c.frac.toFixed(3)));
      if (reduce || !("IntersectionObserver" in window)) { fill(); return; }

      const fmt = (c: (typeof cells)[number], v: number) => v.toFixed(c.dec);
      cells.forEach((c) => (c.node.textContent = fmt(c, 0)));
      const io = new IntersectionObserver((entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        io.disconnect();
        fill();
        const t0 = performance.now(), dur = 900;
        const tick = (now: number) => {
          const p = Math.min(1, (now - t0) / dur);
          const ease = 1 - Math.pow(1 - p, 3);
          cells.forEach((c) => (c.node.textContent = fmt(c, c.value * ease)));
          if (p < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      }, { threshold: 0.35 });
      io.observe(table);
      // never leave zeros behind for printing
      addEventListener("beforeprint", () => { io.disconnect(); cells.forEach((c) => (c.node.textContent = fmt(c, c.value))); fill(); }, { once: true });
    });
  }


  // click a post image: it grows into a fullscreen view, click or Esc to shrink it back
  function initZoom() {
    document.querySelectorAll<HTMLImageElement>(".prose img").forEach((img) => {
      if ((img as any)._zoom) return;
      (img as any)._zoom = true;
      img.classList.add("zoomable");
      img.addEventListener("click", () => openZoom(img));
    });
  }
  function openZoom(img: HTMLImageElement) {
    if (document.querySelector(".zoom-overlay")) return;
    const doc = document as any;
    const vt = !!doc.startViewTransition && !matchMedia("(prefers-reduced-motion: reduce)").matches;
    const overlay = document.createElement("div");
    overlay.className = "zoom-overlay";
    overlay.setAttribute("role", "dialog");
    overlay.setAttribute("aria-label", img.alt || "Image");
    const big = img.cloneNode() as HTMLImageElement;
    big.removeAttribute("class");
    big.removeAttribute("loading");
    overlay.append(big);

    const onKey = (e: KeyboardEvent) => { if (e.key === "Escape") close(); };
    const close = () => {
      removeEventListener("keydown", onKey);
      const swap = () => { big.style.viewTransitionName = ""; overlay.remove(); img.style.viewTransitionName = "zoom-img"; };
      if (!vt) { overlay.remove(); return; }
      doc.startViewTransition(swap).finished.finally(() => (img.style.viewTransitionName = ""));
    };
    overlay.addEventListener("click", close);
    addEventListener("keydown", onKey);

    const open = () => { img.style.viewTransitionName = ""; big.style.viewTransitionName = "zoom-img"; document.body.append(overlay); };
    if (vt) { img.style.viewTransitionName = "zoom-img"; doc.startViewTransition(open); } else open();
  }
  document.addEventListener("astro:before-swap", () => document.querySelector(".zoom-overlay")?.remove());

  // highlighter strokes sweep across <mark> phrases as they come into view
  function initMarks() {
    const marks = Array.from(document.querySelectorAll(".prose mark"));
    if (!marks.length) return;
    if (matchMedia("(prefers-reduced-motion: reduce)").matches || !("IntersectionObserver" in window)) return;
    document.documentElement.classList.add("marks-armed");
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add("on"); io.unobserve(e.target); } });
    }, { threshold: 1, rootMargin: "0px 0px -12% 0px" });
    marks.forEach((m) => { if (!m.classList.contains("on")) io.observe(m); });
  }

  const initAll = () => { initPost(); initTables(); initZoom(); initMarks(); };
  initAll();
  document.addEventListener("astro:page-load", initAll);
</script>
